:host{display:inline-block;line-height:0;pointer-events:none}
.home-motion{position:relative;display:block}
.home-canvas,.home-fallback{position:absolute;left:0;top:0;width:100%;height:100%;display:block;opacity:0;transition:opacity 160ms ease;background:transparent}
.home-canvas.is-visible,.home-fallback.is-visible{opacity:1}
