.reward-mask{position:fixed;inset:0;z-index:900;background:rgba(23,25,31,.35);display:flex;align-items:center;justify-content:center}.reward-card{width:550rpx;padding:38rpx 28rpx 34rpx;background:#fffdf4;border:3rpx solid #17191f;border-radius:36rpx;box-shadow:0 10rpx 0 #17191f;text-align:center;box-sizing:border-box}.eyebrow{font-size:21rpx;color:#d46811;letter-spacing:2rpx}.title{font-size:40rpx;font-weight:900;margin-top:12rpx}.name{font-size:32rpx;font-weight:800}.copy{font-size:24rpx;color:#69707a;margin:18rpx 0}.reward-actions{display:flex;flex-direction:column;align-items:center;gap:16rpx;margin-top:24rpx;padding-bottom:2rpx}.reward-card button{width:420rpx;height:70rpx;line-height:64rpx;box-sizing:border-box;border-radius:24rpx;font-size:27rpx;margin:0;padding:0 24rpx}.reward-card button::after{border:none}.use{background:#ff8a2a;color:#17191f;border:3rpx solid #17191f;font-weight:800;box-shadow:0 4rpx 0 rgba(23,25,31,.82)}.later{background:#fffaf0;color:#4f535b;border:2rpx solid rgba(23,25,31,.32);font-weight:700}.error{color:#b43235;font-size:24rpx}
