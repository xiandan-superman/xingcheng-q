:host{display:block;position:relative;margin-top:12rpx;margin-bottom:16rpx}
.companion-band{position:relative;height:100rpx;overflow:visible}
.companion-floor{position:absolute;bottom:0;left:0;right:0;height:10rpx;border-top:4rpx solid #a88051;border-radius:12rpx;background:#eddfb9;box-sizing:border-box}
.companion-canvas{position:absolute;bottom:0;left:0;width:100%;height:184.615rpx;pointer-events:none}
.companion-touch{position:absolute;left:0;right:0;bottom:0;height:100rpx}
.companion-fallback{position:absolute;left:12rpx;right:12rpx;bottom:7rpx;display:flex;justify-content:space-around;align-items:flex-end}
