.companion-settings{padding-bottom:calc(210rpx + env(safe-area-inset-bottom))}
.companion-setting-note{padding:24rpx}
.companion-count{font-size:32rpx;font-weight:900;margin-bottom:12rpx}
.companion-setting-note .text-secondary{font-size:24rpx;line-height:1.6}
.companion-color-link{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10rpx;font-size:23rpx;line-height:1.6;color:#746858;margin-top:14rpx}
.companion-color-link text{color:#d96916;text-decoration:underline}
.companion-setting-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx;margin-top:26rpx}
.companion-setting-card{min-width:0;padding:20rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fffaf0;box-shadow:none}
.companion-setting-card.is-selected{background:#f8ff99;box-shadow:4rpx 5rpx 0 #b9ad8a}
.companion-setting-card.is-locked{border-color:#c9c0af;background:#f5f0e8;color:#81776b}
.companion-setting-name{font-size:26rpx;font-weight:800;margin-top:10rpx;line-height:1.5}
.companion-setting-label{font-size:20rpx;color:#746858;line-height:1.45;text-align:center;margin-top:5rpx;word-break:break-all}
.companion-mystery{display:flex;align-items:center;justify-content:center;width:100rpx;height:100rpx;border-radius:50%;background:#e8e2d6;color:#a69a87;font-size:54rpx}
.companion-setting-footer{position:fixed;left:0;right:0;bottom:0;padding:12rpx 36rpx calc(26rpx + env(safe-area-inset-bottom));background:rgba(255,253,244,.98);border-top:2rpx solid #e5dbc8;z-index:20}
.companion-setting-message{min-height:36rpx;font-size:24rpx;color:#ad492c;line-height:1.5;margin-bottom:8rpx}
