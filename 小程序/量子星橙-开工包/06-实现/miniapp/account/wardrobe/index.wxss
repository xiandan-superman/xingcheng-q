.avatar-preview{text-align:center;padding:22rpx}.avatar-stage{width:230rpx;height:220rpx;margin:0 auto;position:relative;display:flex;align-items:center;justify-content:center}.avatar-layer{position:absolute;left:10rpx;top:5rpx;width:210rpx;height:210rpx;display:block;will-change:transform,opacity}.muted{font-size:23rpx}.colors{display:flex;flex-wrap:wrap;gap:20rpx}.swatch{width:64rpx;height:64rpx;border-radius:50%;border:3rpx solid #d8cfbe;display:flex;align-items:center;justify-content:center}.swatch text{background:#fff;border-radius:50%;width:32rpx;height:32rpx;text-align:center;font-size:24rpx}.selected{outline:4rpx solid #ff8a2a;outline-offset:3rpx}.collection{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx}.shape-card{text-align:center;padding:22rpx 12rpx}.shape-card image,.mystery{width:132rpx;height:132rpx;margin:auto}.mystery{border-radius:28rpx;background:#eee9df;color:#999;font-size:72rpx;position:relative}.mystery text{font-size:27rpx;position:absolute;bottom:5rpx;right:6rpx}.shape-name{font-size:28rpx;font-weight:800;margin:10rpx 0}.progress{font-size:24rpx;color:#a45b21;margin-top:8rpx}
.more-colors{display:flex;align-items:center;justify-content:space-between;min-height:80rpx;color:#80583c;font-size:25rpx}.more-colors text{font-size:32rpx}.more-palette{margin-bottom:12rpx}
.color-look-up .avatar-main{animation:color-breathe-up 650ms ease-out both}.color-look-down .avatar-main{animation:color-breathe-down 450ms ease-in-out both}.color-change .avatar-main{animation:color-change 700ms cubic-bezier(.2,.75,.2,1) both}.color-settle .avatar-main{animation:color-settle 500ms ease-out both}
.color-fx{position:absolute;left:10rpx;top:5rpx;width:210rpx;height:210rpx;pointer-events:none;opacity:0}.color-fx.active{opacity:1}.color-mask{position:absolute;inset:0;border-radius:50%;overflow:hidden}.color-sweep{position:absolute;left:-90rpx;top:-30rpx;width:46rpx;height:270rpx;background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,248,226,.48),rgba(255,255,255,0));filter:blur(5rpx);transform:rotate(16deg);opacity:0}.color-halo{position:absolute;inset:5rpx;border:3rpx solid rgba(255,200,87,.32);border-radius:50%;opacity:0}.color-fx.active .color-sweep{animation:color-sweep 1400ms 180ms cubic-bezier(.25,.7,.25,1) both}.color-fx.active .color-halo{animation:color-halo 1500ms 80ms ease-out both}
.shape-out .avatar-main{animation:shape-out 660ms cubic-bezier(.35,0,.7,1) both}.shape-in .avatar-main{animation:shape-in 1040ms cubic-bezier(.2,.78,.2,1) both}
.shape-fx{position:absolute;inset:0;pointer-events:none;opacity:0}.shape-fx.active{opacity:1}.fx-core,.fx-ring,.fx-star{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);opacity:0}.fx-core{width:30rpx;height:30rpx;border-radius:50%;background:#fff;box-shadow:0 0 20rpx 8rpx rgba(255,200,87,.55)}.fx-ring{width:70rpx;height:70rpx;border:4rpx solid rgba(255,184,91,.5);border-radius:50%}.fx-star{color:#fff3ce;font-size:26rpx;line-height:1}.shape-fx.active .fx-core{animation:core-bloom 1100ms 280ms ease-out both}.shape-fx.active .fx-ring{animation:ring-bloom 1100ms 280ms ease-out both}.shape-fx.active .fx-star{animation:spark-out 900ms 460ms ease-out both}.shape-fx.active .s1{--x:-78rpx;--y:-58rpx}.shape-fx.active .s2{--x:74rpx;--y:-66rpx;color:#7de8f2}.shape-fx.active .s3{--x:82rpx;--y:54rpx;color:#ffd36b}.shape-fx.active .s4{--x:-72rpx;--y:62rpx}
@keyframes color-breathe-up{0%{transform:scale(1)}100%{transform:scale(1.025)}}@keyframes color-breathe-down{0%{transform:scale(1.025)}100%{transform:scale(.985)}}@keyframes color-change{0%{transform:scale(.985)}45%{transform:scale(1.045)}100%{transform:scale(1.015)}}@keyframes color-settle{0%{transform:scale(1.015)}100%{transform:scale(1)}}@keyframes color-sweep{0%{opacity:0;transform:translateX(0) rotate(16deg)}18%{opacity:.65}82%{opacity:.55}100%{opacity:0;transform:translateX(350rpx) rotate(16deg)}}@keyframes color-halo{0%{opacity:0;transform:scale(.82)}35%{opacity:.55;transform:scale(.96)}72%{opacity:.28;transform:scale(1.06)}100%{opacity:0;transform:scale(1.12)}}@keyframes shape-out{0%{opacity:1;transform:translateY(0) scale(1) rotate(0)}45%{opacity:1;transform:translateY(8rpx) scaleX(1.16) scaleY(.78) rotate(-4deg)}100%{opacity:0;transform:scale(.12) rotate(-95deg)}}@keyframes shape-in{0%{opacity:0;transform:scale(.12) rotate(115deg)}45%{opacity:1;transform:translateY(-10rpx) scale(1.14) rotate(-3deg)}72%{opacity:1;transform:translateY(4rpx) scale(.96) rotate(1deg)}100%{opacity:1;transform:translateY(0) scale(1) rotate(0)}}@keyframes core-bloom{0%{opacity:0;transform:translate(-50%,-50%) scale(.2)}28%{opacity:1;transform:translate(-50%,-50%) scale(1.25)}55%{opacity:1;transform:translate(-50%,-50%) scale(.8)}100%{opacity:0;transform:translate(-50%,-50%) scale(2.2)}}@keyframes ring-bloom{0%{opacity:0;transform:translate(-50%,-50%) scale(.45)}38%{opacity:.8;transform:translate(-50%,-50%) scale(.8)}70%{opacity:.45;transform:translate(-50%,-50%) scale(1.25)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.65)}}@keyframes spark-out{0%{opacity:0;transform:translate(-50%,-50%) scale(.2)}35%{opacity:1}100%{opacity:0;transform:translate(calc(-50% + var(--x)),calc(-50% + var(--y))) scale(.5) rotate(90deg)}}
